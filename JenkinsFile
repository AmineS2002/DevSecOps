
pipeline {
    agent any
     environment {
        SONARQUBE_URL = 'http://localhost:9000'
        SONARQUBE_TOKEN = credentials('SonarQube')
        DOCKER_IMAGE = "amines2002/devsecops"
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Récupération du code source') {
            steps {
                checkout scm
                echo 'Code source récupéré avec succès.'
            }
        }

       
        stage('Clean') {
            steps {
                sh 'mvn -B clean'
    }
    
}
stage('SCA - OWASP Dependency-Check') {
    steps {
        withCredentials([
            string(credentialsId: 'NVD_API_KEY',
                   variable: 'NVD_API_KEY')
        ]) {
            sh '''
                set +x

                mvn -B org.owasp:dependency-check-maven:13.0.0:check \
                    -DnvdApiKey="$NVD_API_KEY"
            '''
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'target/dependency-check-report.html',
                             allowEmptyArchive: true
        }
    }
}
  stage('Compile') {
            steps {
                sh 'mvn -B -DskipTests=true compile'
    }
}
stage('SAST - SpotBugs') {
    steps {
        sh 'mvn -B spotbugs:spotbugs'
    }
    post {
        always {
            recordIssues(
                tools: [
                    spotBugs(pattern: 'target/spotbugsXml.xml')
                ]
            )
        }
    }
}
stage('SonarQube Analysis') {
    steps {
        withCredentials([string(
            credentialsId: 'SonarQube',
            variable: 'SONARQUBE_TOKEN'
        )]) {
            sh '''
                set +x

                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                -Dsonar.projectKey=student-management \
                -Dsonar.host.url=http://localhost:9000 \
                -Dsonar.token="$SONARQUBE_TOKEN" \
                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
            '''
        }
    }
}
  stage('Package') {
            steps {
                sh 'mvn -B -DskipTests=true package'
    }
}

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $DOCKER_IMAGE:latest .'
            }
        }
        stage('Trivy Vulnerability Scan') {
    steps {
        sh '''
            mkdir -p reports

            curl -fsSL \
                https://raw.githubusercontent.com/aquasecurity/trivy/v0.76.1/contrib/html.tpl \
                -o reports/html.tpl

            trivy image \
                --timeout 15m \
                --format template \
                --template "@reports/html.tpl" \
                --output reports/trivy-report.html \
                amines2002/devsecops:latest

            trivy image \
                --timeout 15m \
                --format json \
                --output reports/trivy-report.json \
                amines2002/devsecops:latest
        '''
    }
}

stage('Publish Trivy Report') {
    steps {
        publishHTML(target: [
            reportName: 'Trivy Vulnerability Report',
            reportDir: 'reports',
            reportFiles: 'trivy-report.html',
            keepAll: true,
            alwaysLinkToLastBuild: true,
            allowMissing: false
        ])

        archiveArtifacts artifacts: 'reports/trivy-report.json',
                         fingerprint: true
    }
}
stage('Nmap Deployment Security Scan') {
    steps {
        sh '''
            set -e

            echo "Starting Nmap deployment scan..."

            mkdir -p reports/nmap

            nmap -Pn -sV --reason \
                -oN reports/nmap/deployment-scan.txt \
                -oX reports/nmap/deployment-scan.xml \
                192.168.50.4

            echo "Nmap scan completed successfully."
        '''
    }

    post {
        always {
            archiveArtifacts artifacts: 'reports/nmap/*',
                             allowEmptyArchive: true,
                             fingerprint: true
        }
    }
}
stage('Acceptance - Ansible Infrastructure Verification') {
    steps {
        sh '''#!/bin/bash
            set -o pipefail

            mkdir -p "$WORKSPACE/reports"

            cd "$WORKSPACE/ansible"

            ansible-playbook \
                -i inventory.ini \
                acceptance.yml \
                2>&1 | tee "$WORKSPACE/reports/ansible-acceptance-report.txt"
        '''
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/ansible-acceptance-report.txt',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }
    }
}

        stage('Login DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: '123456789',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
            }
        }
        /* stage('Push Docker Image') {
            steps {
                sh 'docker push $DOCKER_IMAGE:latest'
            }
        }*/
        stage('Deploy Application with Docker Compose') {
    steps {
        sh '''
            set -e

            echo "Validating Docker Compose configuration..."
            docker compose --env-file /opt/student-management/.env \
                -f docker-compose.yml config -q

            echo "Deploying locally built Docker image..."
            docker compose --env-file /opt/student-management/.env \
                -f docker-compose.yml up -d --pull never --force-recreate

            echo "Checking running containers..."
            docker compose --env-file /opt/student-management/.env \
                -f docker-compose.yml ps
        '''
    }
}

stage('OSSEC Host Security Verification') {
    steps {
        sh '''
            set -e

            echo "Starting OSSEC host security verification..."

            mkdir -p reports/ossec

            sudo -n /usr/local/sbin/ossec-jenkins-check \
                > reports/ossec/ossec-report.txt

            echo "OSSEC verification completed successfully."

            cat reports/ossec/ossec-report.txt
        '''
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'reports/ossec/ossec-report.txt',
                allowEmptyArchive: true,
                fingerprint: true
            )
        }
    }
}

stage('Monitoring Verification - Prometheus') {
    steps {
        sh '''
            set -e

            echo "Checking Prometheus availability..."

            curl -fsS http://localhost:9090/-/ready

            echo "Waiting for Student Management target to become UP..."

            for i in $(seq 1 12); do

                RESULT=$(curl -sG \
                    --data-urlencode 'query=up{job="student-management"}' \
                    http://localhost:9090/api/v1/query)

                STATUS=$(echo "$RESULT" | python3 -c '
import json, sys
data = json.load(sys.stdin)
results = data.get("data", {}).get("result", [])
if data.get("status") != "success" or not results:
    print("DOWN")
else:
    print(results[0]["value"][1])
')

                if [ "$STATUS" = "1" ]; then
                    echo "SUCCESS: Student Management is UP in Prometheus."
                    exit 0
                fi

                echo "Application not yet detected as UP. Attempt $i/12"
                sleep 5
            done

            echo "ERROR: Prometheus did not detect Student Management as UP."
            exit 1
        '''
    }
}






    }
}
