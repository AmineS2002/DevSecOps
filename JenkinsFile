
pipeline {
    agent any
     environment {
        SONARQUBE_URL = 'http://localhost:9000'
        SONARQUBE_TOKEN = credentials('SonarQube')
        DOCKER_IMAGE = "amines2002/devsecops"
    }

    triggers {
        githubPush()
    }

    stages {
        stage('Récupération du code source') {
            steps {
                checkout scm
                echo 'Code source récupéré avec succès.'
            }
        }

        stage('Affichage de la date système') {
            steps {
                sh 'date'
            }
        }
        stage('Clean') {
            steps {
                sh 'mvn -B clean'
    }
    
}
stage('SCA - OWASP Dependency-Check') {
    steps {
        withCredentials([
            string(credentialsId: 'NVD_API_KEY',
                   variable: 'NVD_API_KEY')
        ]) {
            sh '''
                set +x

                mvn -B org.owasp:dependency-check-maven:13.0.0:check \
                    -DnvdApiKey="$NVD_API_KEY"
            '''
        }
    }
    post {
        always {
            archiveArtifacts artifacts: 'target/dependency-check-report.html',
                             allowEmptyArchive: true
        }
    }
}
  stage('Compile') {
            steps {
                sh 'mvn -B -DskipTests=true compile'
    }
}
stage('SAST - SpotBugs') {
    steps {
        sh 'mvn -B spotbugs:spotbugs'
    }
    post {
        always {
            recordIssues(
                tools: [
                    spotBugs(pattern: 'target/spotbugsXml.xml')
                ]
            )
        }
    }
}
  stage('Package') {
            steps {
                sh 'mvn -B -DskipTests=true package'
    }
}
stage('SonarQube Analysis') {
    steps {
        withCredentials([string(
            credentialsId: 'SonarQube',
            variable: 'SONARQUBE_TOKEN'
        )]) {
            sh '''
                set +x

                mvn org.sonarsource.scanner.maven:sonar-maven-plugin:5.1.0.4751:sonar \
                -Dsonar.projectKey=student-management \
                -Dsonar.host.url=http://localhost:9000 \
                -Dsonar.token="$SONARQUBE_TOKEN" \
                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
            '''
        }
    }
}
        stage('Build Docker Image') {
            steps {
                sh 'docker build -t $DOCKER_IMAGE:latest .'
            }
        }

        stage('Login DockerHub') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: '123456789',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                }
            }
        }
         stage('Push Docker Image') {
            steps {
                sh 'docker push $DOCKER_IMAGE:latest'
            }
        }
        stage('Deploy with Docker Compose') {
            steps {
                sh '''
                    docker compose \
                      --env-file /opt/student-management/.env \
                      -f "$WORKSPACE/docker-compose.yml" \
                      pull

                    docker compose \
                      --env-file /opt/student-management/.env \
                      -f "$WORKSPACE/docker-compose.yml" \
                      up -d
                '''
            }
        }



    }
}
